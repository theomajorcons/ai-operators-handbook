---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/base';
import { byLessonOrder } from '../lib/lesson-order';
import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';

// --- Which lessons reference which artifact (from `download:` frontmatter) ---
const lessons = (await getCollection('lessons')).sort(byLessonOrder);
const usedBy = new Map<string, { lessonId: string; lessonTitle: string }[]>();
for (const l of lessons) {
  const file = l.data.download;
  if (!file) continue;
  (usedBy.get(file) ?? usedBy.set(file, []).get(file)!).push({
    lessonId: l.id,
    lessonTitle: l.data.title,
  });
}

// --- Enumerate every downloadable artifact on disk ---
// Resolved from the project root (cwd during build) - public/ isn't adjacent to
// this module once Astro bundles it.
const artifactsDir = join(process.cwd(), 'public', 'artifacts');
const files = readdirSync(artifactsDir).filter((f) => f.endsWith('.md')).sort();

// Title = the artifact's own H1; fall back to a title-cased filename. The H1 is
// the single source of truth so a renamed artifact re-titles itself here.
function h1Of(path: string, fallback: string): string {
  try {
    const m = readFileSync(path, 'utf8').match(/^#\s+(.+)$/m);
    return m ? m[1].trim() : fallback;
  } catch {
    return fallback;
  }
}
const titleCase = (slug: string) =>
  slug.replace(/\.md$/, '').replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

// Type is inferred from the filename suffix - the naming convention already
// encodes it (…-checklist.md, …-template.md, …-cheatsheet.md, …-tracker.md,
// …-scorecard/scorecard.md). Anything else lands in "Other resources".
// ponytail: suffix match, no per-file map; add a key here if a new suffix appears.
const TYPES: { id: string; label: string; test: (f: string) => boolean }[] = [
  { id: 'cheatsheet', label: 'Cheat-sheets & cards', test: (f) => /cheatsheet|-card|-guide|-map|-lineup|-links/.test(f) },
  { id: 'checklist', label: 'Checklists', test: (f) => /checklist|ladder|gate/.test(f) },
  { id: 'template', label: 'Templates & starters', test: (f) => /template|starter|-brief|-plan|-sheet|-spec/.test(f) },
  { id: 'tracker', label: 'Trackers & scorecards', test: (f) => /tracker|scorecard|-challenge/.test(f) },
];
const typeOf = (f: string) => TYPES.find((t) => t.test(f))?.id ?? 'other';

const items = files.map((f) => ({
  file: f,
  title: h1Of(join(artifactsDir, f), titleCase(f)),
  href: withBase(`/artifacts/${f}`),
  type: typeOf(f),
  lessons: usedBy.get(f) ?? [],
}));

// Group by type in the TYPES order, then "Other resources" last. Empty groups
// are dropped so the page only shows categories that actually have files.
const sections = [
  ...TYPES.map((t) => ({ label: t.label, items: items.filter((i) => i.type === t.id) })),
  { label: 'Other resources', items: items.filter((i) => i.type === 'other') },
].filter((s) => s.items.length > 0);

const totalFiles = items.length;
---

<BaseLayout title="Downloads" description="Every cheat sheet and challenge from the course in one place, ready to download and keep beside you while you work." width="wide">
  <section class="r-head" aria-labelledby="r-title">
    <p class="eyebrow">Reference spine</p>
    <h1 id="r-title" class="r-title">Downloads &amp; Cheat-sheets</h1>
    <p class="r-lede">
      Every checklist, template, cheat-sheet, and tracker the handbook ships,
      in one place. Grab what you need directly, or follow the link back to the
      lesson that puts it to work.
    </p>
    <p class="r-overview">
      <span>{totalFiles} resource{totalFiles === 1 ? '' : 's'}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span>{sections.length} categor{sections.length === 1 ? 'y' : 'ies'}</span>
    </p>
  </section>

  {sections.map((s) => (
    <section class="r-section" aria-label={s.label}>
      <h2 class="r-cat">{s.label}</h2>
      <ul class="r-grid" role="list">
        {s.items.map((it) => (
          <li class="r-card">
            <a class="r-card__dl" href={it.href} download>
              <span class="r-card__icon" aria-hidden="true">↓</span>
              <span class="r-card__title">{it.title}</span>
              <span class="r-card__file">{it.file}</span>
            </a>
            {it.lessons.length > 0 && (
              <p class="r-used">
                <span class="r-used__label">Used in</span>
                {it.lessons.map((l) => (
                  <a class="r-used__link" href={withBase(`/lessons/${l.lessonId}`)}>{l.lessonTitle}</a>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .r-head { max-width: 60ch; margin-bottom: var(--space-10); }
  .r-title {
    margin: 0;
    font-size: var(--fs-display);
    background: linear-gradient(120deg, var(--text) 30%, var(--accent-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .r-lede {
    margin: var(--space-6) 0 0;
    font-size: var(--fs-md);
    color: var(--muted);
    max-width: 58ch;
  }
  .r-overview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .r-overview .dot { color: var(--accent); }

  .r-section { margin-bottom: var(--space-10); }
  .r-cat {
    margin: 0 0 var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    color: var(--accent);
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: var(--space-2);
  }
  .r-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-4);
  }
  .r-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--gradient-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-panel);
  }
  .r-card__dl {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    color: var(--text);
  }
  .r-card__dl:hover { text-decoration: none; }
  .r-card__dl:hover .r-card__title { color: var(--accent-strong); }
  .r-card__icon {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    color: var(--accent-strong);
    font-size: var(--fs-md);
  }
  .r-card__title {
    font-weight: 650;
    line-height: var(--leading-tight);
    transition: color 0.15s ease;
  }
  .r-card__file {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
    word-break: break-all;
  }
  .r-used {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }
  .r-used__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .r-used__link {
    font-size: var(--fs-xs);
    color: var(--accent-strong);
  }
  .r-used__link:hover { text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) {
    .r-card__title { transition: none; }
  }
</style>
