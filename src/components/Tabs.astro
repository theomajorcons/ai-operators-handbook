---
// Reusable ARIA tabs (APG tablist pattern), token-driven, both themes.
// Pass tab labels via `tabs`; provide one panel per label in a named slot
// keyed by index: slot="panel-0", slot="panel-1", …
//
// Progressive enhancement: with JS off (or before hydration) every panel is
// visible and the tablist renders as plain headings, so the content is never
// hidden from a reader or crawler. The client script then wires roving
// tabindex, arrow/Home/End keys, and single-panel visibility.
interface Props {
  tabs: string[];
  label: string;          // accessible name for the tablist
  idBase?: string;        // unique prefix when several Tabs share a page
}
const { tabs, label, idBase = 'tabs' } = Astro.props;
const uid = `${idBase}-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="tabs" data-tabs>
  <div class="tabs__list" role="tablist" aria-label={label}>
    {tabs.map((t, i) => (
      <button
        type="button"
        class="tabs__tab"
        role="tab"
        id={`${uid}-tab-${i}`}
        aria-controls={`${uid}-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        {t}
      </button>
    ))}
  </div>
  {tabs.map((_, i) => (
    <div
      class="tabs__panel"
      role="tabpanel"
      id={`${uid}-panel-${i}`}
      aria-labelledby={`${uid}-tab-${i}`}
      tabindex="0"
      hidden={i !== 0}
    >
      <slot name={`panel-${i}`} />
    </div>
  ))}
</div>

<style>
  .tabs { margin-block: var(--space-6); }

  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .tabs__tab {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .tabs__tab:hover {
    color: var(--text);
    background: var(--accent-dim);
  }
  .tabs__tab[aria-selected='true'] {
    color: var(--accent-strong);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: var(--glow-sm);
  }

  .tabs__panel {
    padding-top: var(--space-4);
  }
  /* The panel is focusable (tabindex=0) but should not show a focus ring on
     the programmatic focus the script moves to it after a tab change. */
  .tabs__panel:focus { outline: none; }
  .tabs__panel :global(> :first-child) { margin-top: 0; }
  .tabs__panel :global(> :last-child) { margin-bottom: 0; }

  @media (prefers-reduced-motion: reduce) {
    .tabs__tab { transition: none; }
  }
</style>

<script>
  // APG tabs keyboard + selection behavior, applied to every [data-tabs].
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const select = (i: number, focusPanel = false) => {
      tabs.forEach((tab, j) => {
        const on = j === i;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focusPanel) panels[i].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next = -1;
        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next < 0) return;
        e.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });
  }
</script>
