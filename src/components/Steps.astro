---
/* Ordered sequence of operational steps. The <ol> carries the "this is an
   ordered list" semantics for assistive tech; the visible number bubbles are
   decorative (aria-hidden) so order isn't announced twice. */
---
<ol class="steps"><slot /></ol>

<style>
  .steps {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
