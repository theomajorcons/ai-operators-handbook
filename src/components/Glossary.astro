---
// End-of-lesson "Key terms" glossary. Scan-friendly: bold term, plain definition.
interface Term {
  term: string;
  definition: string;
}
interface Props {
  terms: Term[];
  label?: string;
}
const { terms, label = 'Key terms' } = Astro.props;
---

<aside class="glossary" aria-label={label}>
  <p class="glossary__label">
    <span class="glossary__icon" aria-hidden="true">📖</span>
    {label}
  </p>
  <dl class="glossary__list">
    {terms.map((t) => (
      <div class="glossary__row">
        <dt class="glossary__term">{t.term}</dt>
        <dd class="glossary__def">{t.definition}</dd>
      </div>
    ))}
  </dl>
</aside>

<style>
  .glossary {
    --c: var(--key);
    background: color-mix(in srgb, var(--c) var(--tint), var(--surface));
    border: 1px solid color-mix(in srgb, var(--c) 30%, var(--border));
    border-left: 3px solid var(--c);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-6);
    margin-block: var(--space-6);
  }
  .glossary__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c);
  }
  .glossary__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4em;
    height: 1.4em;
    font-size: 0.95em;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c) 18%, transparent);
    line-height: 1;
  }
  .glossary__list { margin: 0; }
  .glossary__row { margin-block: var(--space-3); }
  .glossary__row:first-child { margin-top: 0; }
  .glossary__row:last-child { margin-bottom: 0; }
  .glossary__term {
    font-weight: 700;
    color: var(--text);
  }
  .glossary__def {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
</style>
