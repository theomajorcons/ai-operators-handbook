---
import { withBase } from '../lib/base';
interface Props {
  label: string;
  file: string;
}
const { label, file } = Astro.props;
const mdHref = withBase('/artifacts/' + file);
const docxFile = file.replace(/\.md$/, '.docx');
const docxHref = withBase('/artifacts/' + docxFile);
---

<div class="artifact">
  <span class="artifact__icon" aria-hidden="true">↓</span>
  <span class="artifact__label">{label}</span>
  <span class="artifact__links">
    <a class="artifact__link" href={mdHref} download aria-label={label + ', Markdown (.md) download'}>Markdown (.md)</a>
    <a class="artifact__link" href={docxHref} download aria-label={label + ', Word (.docx) download'}>Word (.docx)</a>
  </span>
</div>

<style>
  .artifact {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    max-width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    color: var(--text);
  }

  .artifact__icon {
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    color: var(--accent-strong);
    font-size: var(--fs-md);
    line-height: 1;
  }

  .artifact__label {
    font-weight: 600;
    color: var(--text);
  }

  .artifact__links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    min-width: 0;
  }

  .artifact__link {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--accent-strong);
    text-decoration: underline;
    overflow-wrap: anywhere;
    transition: color 0.1s ease;
  }
  .artifact__link:hover,
  .artifact__link:focus-visible {
    color: var(--text);
  }
</style>
